---
import Icon from './Icon.astro';
import { wa } from '../data/site';

/**
 * CONTRATO Ads/GA4: el botón persistente se llama distinto según la página en producción
 * (whatsapp_floating en home y proyectos, whatsapp_click|landing_persistent en las landings,
 * catalog-persistent en el catálogo). No unificar los nombres sin aprobación.
 */
interface Props {
  context: string;
  advice: string;
  product: string;
  conversion?: string;
  placement?: string;
  trackedContext?: string;
  id?: string;
}
const {
  context, advice, product,
  conversion = 'whatsapp_click', placement = 'landing_persistent', trackedContext, id,
} = Astro.props;
---
<a id={id} class="dock" href={wa(advice)} target="_blank" rel="noopener noreferrer"
   aria-label={`Pedir cotización por WhatsApp sobre ${product}`}
   data-conversion={conversion} data-conversion-placement={placement || undefined}
   data-context={trackedContext ?? context}>
  <Icon name="whatsapp-logo" /><span data-whatsapp-label>Hablar con un asesor</span>
</a>

<style>
  /* Botón fijo de WhatsApp: visible siempre, en todos los tamaños. Verde para que se reconozca sin
     leer. En móvil era una franja verde de 60 px a todo el ancho: junto al CTA del header quedaban dos
     bloques fijos, del mismo tamaño y al mismo WhatsApp. Ahora es una pastilla al ancho de su
     texto, apoyada a la derecha. Conserva el texto, que es lo que hace que la toquen. */
  .dock {
    position: fixed; z-index: 40;
    right: 16px; bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 0 20px; border-radius: 999px;
    background: var(--wa); color: var(--ink);
    font-weight: 600; font-size: var(--fs-small); text-decoration: none;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    transition: transform 0.2s var(--ease), background-color 0.3s var(--ease);
  }
  .dock:hover { background: var(--wa-hover); }
  .dock:active { transform: scale(0.98); }
  .dock :global(svg) { width: 24px; height: 24px; }
  /* Reserva para que el botón nunca tape el final de la página. */
  :global(body) { padding-bottom: 76px; }

  /* Desktop: visible desde que carga. Mobile: aparece apenas se empieza a scrollear, así no queda
     pegado al botón del hero en la primera pantalla. Con reduced-motion, visible siempre. */
  @media (prefers-reduced-motion: no-preference) {
    .dock { animation: dock-in 0.7s var(--ease) 0.9s both; }
    @media (max-width: 959px) {
      @supports (animation-timeline: scroll()) {
        .dock {
          animation: dock-scroll linear both;
          animation-timeline: scroll(root);
          animation-range: 0 12vh;
        }
      }
    }
  }
  @keyframes dock-in { from { opacity: 0; transform: translateY(24px); } }
  @keyframes dock-scroll {
    from { opacity: 0; transform: translateY(24px); visibility: hidden; }
    to { opacity: 1; transform: none; visibility: visible; }
  }

  @media (min-width: 960px) {
    .dock { right: 32px; bottom: 32px; min-height: 60px; padding: 0 28px 0 22px; font-size: 1.125rem; }
    .dock :global(svg) { width: 28px; height: 28px; }
    :global(body) { padding-bottom: 0; }
  }
</style>
