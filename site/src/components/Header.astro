---
/**
 * Header único: arriba de todo es una barra ancha con mega-menú; a medida que se baja se contrae
 * en una pastilla flotante translúcida. NO son dos estados con un salto: todo lo que cambia
 * (ancho, alto, radio, opacidad, blur, sombra, tamaño del logo) se interpola con una sola
 * variable `--hdr-t` que va de 0 a 1 en los primeros 140 px de scroll.
 *
 * `--hdr-t` la mueve la animación ligada al scroll (`animation-timeline: scroll()`), que corre en
 * el compositor y sigue al dedo sin un solo listener. Donde no existe (Safari, Firefox viejo) la
 * mueve el fallback de JS con requestAnimationFrame. Los estilos son los mismos en los dos casos:
 * hay un solo juego de reglas, no dos caminos que se desincronizan.
 * OJO: esto depende de `cssMinify: 'esbuild'` en astro.config.mjs — lightningcss fusiona
 * `animation` con `animation-timeline` en un shorthand que Chrome descarta entero.
 *
 * Los enlaces de producto salen de lib/menu.ts: la subcategoría ancla en el bloque de modelos de
 * la landing, no en el catálogo viejo.
 * CONTRATO Ads/GA4: cada página conserva su nombre de evento. Las landings usan
 * whatsapp_click|landing_header; la home, whatsapp_header sin placement; el catálogo y proyectos
 * no miden el header.
 */
import Icon from './Icon.astro';
import { wa } from '../data/site';
import { menuCategories } from '../lib/menu';

interface Cta { conversion: string; placement?: string; context?: string }
interface Props {
  context: string;
  advice: string;
  current?: string;
  cta?: Cta | null;
  mobileCta?: Cta | null;
}
const {
  context, advice, current,
  cta = { conversion: 'whatsapp_click', placement: 'landing_header' },
  mobileCta = null,
} = Astro.props;

const sections = [
  { label: 'Proyectos', href: '/proyectos.html' },
  { label: 'Nosotros', href: '/index.html#about' },
];
---
<header class="hdr">
  <div class="hdr__bar">
    <a class="hdr__brand" href="/index.html" aria-label="RTM Pantallas LED, inicio">
      <img src="/rtm_logo/rtmLogo-transparente.png" alt="RTM Pantallas LED" width="300" height="60">
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      <a href="/index.html" aria-current={current === '/index.html' ? 'page' : undefined}>Inicio</a>
      <button type="button" class="hdr__products" aria-expanded="false" aria-controls="hdr-panel"
              aria-current={current === '/productos.html' ? 'page' : undefined}>
        Productos<Icon name="arrow-down" />
      </button>
      {sections.map(s => (
        <a href={s.href} aria-current={s.href === current ? 'page' : undefined}>{s.label}</a>
      ))}
    </nav>

    <div class="hdr__end">
      <a class="btn btn--primary hdr__cta" href={wa(advice)} target="_blank" rel="noopener noreferrer"
         data-conversion={cta?.conversion}
         data-conversion-placement={cta?.placement || undefined}
         data-context={cta ? (cta.context ?? context) : undefined}>
        <Icon name="whatsapp-logo" /><span class="hdr__cta-long">Pedir cotización</span><span class="hdr__cta-short">Cotizar</span>
      </a>

      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="hdr-drawer"
              aria-label="Abrir menú">
        <span class="hdr__burger-open"><Icon name="list" /></span>
        <span class="hdr__burger-close"><Icon name="x" /></span>
      </button>
    </div>
  </div>

  <!-- Mega-menú (escritorio). Acompaña la contracción: de ancho completo a tarjeta redondeada. -->
  <div class="hdr__panel" id="hdr-panel" hidden>
    <div class="hdr__panel-inner">
      <div class="hdr__grid">
        {menuCategories.map(cat => (
          <div class="hdr__cat">
            <a class="hdr__cat-title" href={cat.href}>{cat.label}<Icon name="arrow-up-right" /></a>
            {cat.items.length > 0 && (
              <ul>{cat.items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul>
            )}
          </div>
        ))}
      </div>
      <a class="hdr__panel-all" href="/productos.html">Ver el catálogo completo<Icon name="arrow-right" /></a>
    </div>
  </div>

  <!-- Menú móvil. Ocupa la pantalla pero queda POR DEBAJO de la barra: el botón que lo abre es el
       mismo que lo cierra y tiene que seguir siendo tocable. Dos grillas de dos columnas, para que
       los doce enlaces entren en una pantalla sin scrollear y se lean alineados. -->
  <div class="hdr__drawer" id="hdr-drawer" hidden>
    <div class="hdr__drawer-inner">
      <p class="hdr__drawer-label" id="hdr-drawer-prod">Productos</p>
      <ul class="hdr__drawer-products" aria-labelledby="hdr-drawer-prod">
        {menuCategories.map(cat => <li><a href={cat.href}>{cat.label}</a></li>)}
      </ul>
      <p class="hdr__drawer-label" id="hdr-drawer-sec">Secciones</p>
      <ul class="hdr__drawer-links" aria-labelledby="hdr-drawer-sec">
        <li><a href="/index.html">Inicio</a></li>
        <li><a href="/productos.html">Catálogo</a></li>
        {sections.map(s => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
      {mobileCta && (
        <a class="btn btn--primary hdr__drawer-cta" href={wa(advice)} target="_blank" rel="noopener noreferrer"
           data-conversion={mobileCta.conversion}
           data-conversion-placement={mobileCta.placement || undefined}
           data-context={mobileCta.context ?? context}>
          Cotizar por WhatsApp
        </a>
      )}
    </div>
  </div>
</header>
<!-- El header es fijo: este hueco evita que tape el primer bloque de la página. -->
<div class="hdr-spacer" aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('.hdr');
  if (header) {
    const panel = header.querySelector<HTMLElement>('.hdr__panel')!;
    const panelBtn = header.querySelector<HTMLButtonElement>('.hdr__products')!;
    const drawer = header.querySelector<HTMLElement>('.hdr__drawer')!;
    const burger = header.querySelector<HTMLButtonElement>('.hdr__burger')!;

    const toggle = (el: HTMLElement, btn: HTMLButtonElement, open: boolean) => {
      el.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };

    /**
     * Menú móvil. Tres cosas que antes no estaban:
     * - el botón cambia de cara y de etiqueta, porque es el único modo de cerrar con el pulgar;
     * - el fondo se congela guardando y devolviendo la posición (con `overflow: hidden` a secas
     *   iOS pierde dónde estabas al cerrar);
     * - abrir empuja una entrada de historia, así el botón "atrás" del teléfono cierra el menú en
     *   vez de sacar del sitio. Al tocar un link no se deshace: el link ya navega, y llamar a
     *   history.back() ahí compite con esa navegación.
     */
    let lockedAt = 0;
    const setDrawer = (open: boolean) => {
      if (open === !drawer.hidden) return;
      toggle(drawer, burger, open);
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      header.classList.toggle('hdr--open', open);
      const body = document.body;
      if (open) {
        lockedAt = window.scrollY;
        body.style.position = 'fixed';
        body.style.top = `-${lockedAt}px`;
        body.style.width = '100%';
      } else {
        body.style.position = '';
        body.style.top = '';
        body.style.width = '';
        window.scrollTo(0, lockedAt);
      }
    };
    const closeDrawer = () => {
      if (history.state?.rtmMenu) history.back(); // popstate termina de cerrar
      else setDrawer(false);
    };

    panelBtn.addEventListener('click', () => toggle(panel, panelBtn, panel.hidden));
    burger.addEventListener('click', () => {
      // La entrada de historia se empuja ANTES de congelar el fondo: con el body en `fixed` el
      // scroll vale 0, y el navegador guardaría ese 0 para restaurarlo al volver.
      if (drawer.hidden) { history.pushState({ rtmMenu: true }, ''); setDrawer(true); }
      else closeDrawer();
    });
    window.addEventListener('popstate', () => setDrawer(false));
    // Al volver con el botón "atrás" la página puede restaurarse desde el bfcache con el menú abierto.
    window.addEventListener('pageshow', event => { if (event.persisted) setDrawer(false); });

    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      if (!panel.hidden) { toggle(panel, panelBtn, false); panelBtn.focus(); }
      if (!drawer.hidden) { closeDrawer(); burger.focus(); }
    });
    document.addEventListener('click', event => {
      const target = event.target as Element;
      if (!panel.hidden && !panel.contains(target) && !panelBtn.contains(target)) toggle(panel, panelBtn, false);
      if (target.closest('.hdr__panel a')) toggle(panel, panelBtn, false);
      if (target.closest('.hdr__drawer a')) setDrawer(false);
    });

    // Fallback donde no hay animación ligada al scroll: la misma variable, movida a mano.
    // Con rAF se actualiza una vez por cuadro, no una por evento de scroll.
    if (!CSS.supports('animation-timeline', 'scroll()')) {
      const RANGE = 140;
      let ticking = false;
      const update = () => {
        ticking = false;
        const t = Math.min(1, Math.max(0, window.scrollY / RANGE));
        header.style.setProperty('--hdr-t', String(t));
      };
      update();
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
    }
  }
</script>

<style>
  /* Registrada para poder animarla: sin @property el navegador no interpola una custom property. */
  @property --hdr-t {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .hdr {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    color: var(--white);
    --hdr-t: 0;
  }
  .hdr-spacer { height: var(--header-h); }

  /* Arriba de todo la barra llega a los dos bordes: ese fondo a sangre es esta capa, que se
     desvanece justo mientras la pastilla toma su propio fondo translúcido. Las dos son del mismo
     color, así que en el medio se lee como una sola superficie. */
  .hdr::before {
    content: '';
    position: absolute; inset: 0 0 auto 0;
    height: var(--header-h);
    background: var(--ink);
    opacity: calc(1 - var(--hdr-t));
    pointer-events: none;
  }

  /* Con el menú abierto la barra deja de ser pastilla: ancha, opaca y pegada arriba, para que se
     lea como el techo del menú y no como algo flotando encima. */
  .hdr--open .hdr__bar { --hdr-t: 0; background: var(--ink); }

  @supports (animation-timeline: scroll()) {
    .hdr {
      animation: hdr-morph linear both;
      animation-timeline: scroll(root);
      animation-range: 0 140px;
    }
  }
  @keyframes hdr-morph { from { --hdr-t: 0; } to { --hdr-t: 1; } }

  /* ---------- La barra: todo lo que se contrae ---------- */
  .hdr__bar {
    position: relative; z-index: 2;
    box-sizing: border-box;
    display: flex; align-items: center; gap: 20px;
    width: calc(100% - var(--hdr-t) * 32px);
    max-width: calc(var(--wrap) - var(--hdr-t) * 180px);
    margin-inline: auto;
    margin-top: calc(var(--hdr-t) * 12px);
    height: calc(var(--header-h) - var(--hdr-t) * 12px);
    padding-inline: calc(var(--gutter) - var(--hdr-t) * 8px);
    border: 1px solid rgb(255 255 255 / calc(var(--hdr-t) * 0.12));
    border-radius: calc(var(--hdr-t) * 999px);
    background: rgb(20 20 22 / calc(var(--hdr-t) * 0.72));
    backdrop-filter: blur(calc(var(--hdr-t) * 16px)) saturate(calc(100% + var(--hdr-t) * 60%));
    box-shadow: 0 calc(var(--hdr-t) * 16px) calc(var(--hdr-t) * 40px) rgb(0 0 0 / calc(var(--hdr-t) * 0.34));
  }

  .hdr__brand { display: inline-flex; flex: none; }
  .hdr__brand img { width: calc(150px - var(--hdr-t) * 18px); height: auto; }

  .hdr__nav { display: none; align-items: center; gap: 28px; margin-inline: auto; }
  .hdr__nav a, .hdr__products {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    font-family: inherit; font-size: var(--fs-small);
    color: var(--muted-dark); text-decoration: none;
    background: none; border: 0; padding: 0; cursor: pointer;
    transition: color 0.3s var(--ease);
  }
  .hdr__nav a:hover, .hdr__products:hover,
  .hdr__nav a[aria-current], .hdr__products[aria-current] { color: var(--white); }
  .hdr__products :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .hdr__products[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }

  .hdr__end { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  /* El CTA se ve también en móvil: por ahí entra casi todo el tráfico y es el evento
     whatsapp_header / landing_header que mide GA4. */
  .hdr__cta {
    min-height: calc(48px - var(--hdr-t) * 10px);
    padding-inline: calc(22px - var(--hdr-t) * 8px);
    font-size: calc(1rem - var(--hdr-t) * 0.0625rem);
    gap: calc(10px - var(--hdr-t) * 2px);
  }
  .hdr__cta :global(svg) { width: calc(20px - var(--hdr-t) * 3px); height: calc(20px - var(--hdr-t) * 3px); }
  .hdr__cta-long { display: none; }

  .hdr__burger {
    display: grid; place-items: center;
    width: 44px; height: 44px; flex: none;
    border: 0; border-radius: 999px; cursor: pointer;
    background: rgb(255 255 255 / 0.1); color: var(--white);
  }
  .hdr__burger :global(svg) { width: 22px; height: 22px; display: block; }
  .hdr__burger-close { display: none; }
  .hdr__burger[aria-expanded='true'] .hdr__burger-open { display: none; }
  .hdr__burger[aria-expanded='true'] .hdr__burger-close { display: block; }

  /* En móvil el CTA del header no puede pesar como el botón verde fijo de abajo: los dos van al
     mismo WhatsApp. Pastilla chica, sin encoger con el scroll (ya es el tamaño mínimo tocable).
     No se saca: es el evento whatsapp_header / landing_header que mide GA4. */
  @media (max-width: 1099px) {
    .hdr__cta { min-height: 42px; padding-inline: 14px; font-size: 1rem; gap: 8px; }
    .hdr__cta :global(svg) { width: 18px; height: 18px; }
  }

  /* En teléfonos chicos el logo cede ancho: logo + CTA + botón tienen que entrar en 375 px. */
  @media (max-width: 520px) {
    .hdr__brand img { width: calc(120px - var(--hdr-t) * 12px); }
    .hdr__bar { gap: 12px; }
  }

  /* Con flex y `margin: auto` el menú se centra en el espacio sobrante, y como el logo y el botón
     no miden lo mismo queda corrido. Tres columnas con los laterales iguales lo centran de verdad. */
  @media (min-width: 1100px) {
    .hdr__bar { display: grid; grid-template-columns: 1fr auto 1fr; }
    .hdr__nav { display: inline-flex; margin-inline: 0; justify-self: center; }
    .hdr__end { justify-self: end; margin-left: 0; }
    .hdr__burger { display: none; }
    .hdr__cta-long { display: inline; }
    .hdr__cta-short { display: none; }
  }

  /* ---------- Mega-menú ---------- */
  .hdr__panel {
    position: absolute; left: 50%; transform: translateX(-50%);
    top: calc(100% + var(--hdr-t) * 10px);
    box-sizing: border-box;
    width: calc(100% - var(--hdr-t) * 32px);
    /* Arriba de todo llega a los bordes; contraído se frena en el ancho de la pastilla.
       El +100vw es lo que deja que ese tope se mueva de forma continua. */
    max-width: calc(var(--wrap) - 180px + (1 - var(--hdr-t)) * 100vw);
    border: 1px solid rgb(255 255 255 / calc(var(--hdr-t) * 0.12));
    border-top: 1px solid var(--line-dark);
    border-radius: calc(var(--hdr-t) * var(--radius-lg));
    background: rgb(20 20 22 / calc(1 - 0.06 * var(--hdr-t)));
    backdrop-filter: blur(calc(var(--hdr-t) * 16px));
    box-shadow: 0 calc(var(--hdr-t) * 20px) calc(var(--hdr-t) * 50px) rgb(0 0 0 / calc(var(--hdr-t) * 0.4));
  }
  .hdr__panel-inner {
    width: 100%; max-width: var(--wrap); margin-inline: auto;
    padding: 36px var(--gutter) 40px;
  }
  .hdr__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px 40px; }
  .hdr__cat-title {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--fs-body); font-weight: 600; color: var(--white); text-decoration: none;
  }
  .hdr__cat-title :global(svg) { width: 18px; height: 18px; opacity: 0.55; }
  .hdr__cat ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .hdr__cat ul a { font-size: var(--fs-small); color: var(--muted-dark); text-decoration: none; }
  .hdr__cat ul a:hover { color: var(--white); }
  .hdr__panel-all {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 32px;
    color: var(--white); text-decoration: none; font-size: var(--fs-small);
  }
  .hdr__panel-all :global(svg) { width: 18px; height: 18px; }

  /* ---------- Menú de pantalla completa ----------
     z-index 1: por debajo de la barra (z-index 2). Antes iba encima y tapaba el botón que lo
     abría, así que no había forma de cerrarlo sin navegar a otra página. */
  .hdr__drawer {
    position: fixed; inset: 0; z-index: 1;
    background: var(--ink);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .hdr__drawer-inner {
    width: 100%; max-width: 620px; margin-inline: auto;
    padding: calc(var(--header-h) + 14px) var(--gutter) calc(28px + env(safe-area-inset-bottom));
  }
  .hdr__drawer-label { font-size: var(--fs-small); color: var(--muted-dark); margin: 0 0 2px; }
  .hdr__drawer-inner .hdr__drawer-products { margin-bottom: 30px; }
  /* Dos columnas con filete arriba: ocho productos ocupan cuatro filas y todo entra en una
     pantalla. En una sola columna había que scrollear dentro del menú. */
  .hdr__drawer-inner ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px;
  }
  .hdr__drawer-inner li { border-top: 1px solid var(--line-dark); }
  .hdr__drawer-inner a {
    display: flex; align-items: center; min-height: 54px;
    color: var(--white); text-decoration: none;
    font-size: var(--fs-small); font-weight: 600; line-height: 1.25;
  }
  .hdr__drawer-links a { color: var(--muted-dark); font-weight: 400; }
  .hdr__drawer-cta { margin-top: 20px; width: 100%; }

  @media (prefers-reduced-motion: no-preference) {
    .hdr__drawer { animation: drawer-in 0.18s var(--ease) both; }
  }
  @keyframes drawer-in { from { opacity: 0; } }
</style>
