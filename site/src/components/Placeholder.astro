---
/**
 * Hueco de foto. Las fotos de catálogo que había recortaban mal (la card grande forzaba 640 px de
 * alto sobre una foto apaisada), así que las cards de producto muestran esto hasta que Nicolás
 * elija la imagen. Dice qué foto va y en qué proporción, para poder buscarla sin abrir el código.
 */
interface Props {
  label: string;        // qué se ve en la foto ("Pantallas LED")
  ratio?: string;       // proporción del hueco, tal cual va en aspect-ratio
  hint?: string;        // pista extra ("horizontal, instalación real")
}
const { label, ratio = '16/10', hint } = Astro.props;
---
<div class="ph" style={`--ph-ratio: ${ratio}`} role="img" aria-label={`Foto pendiente: ${label}`}>
  <span class="ph__label">{label}</span>
  <span class="ph__meta">Foto pendiente · {ratio}{hint ? ` · ${hint}` : ''}</span>
</div>

<style>
  .ph {
    aspect-ratio: var(--ph-ratio);
    width: 100%;
    display: grid; align-content: center; justify-items: center; gap: 8px;
    padding: 24px; text-align: center;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.035) 0 12px, transparent 12px 24px),
      var(--mist);
    border: 1px dashed var(--line-light);
    color: var(--muted-light);
  }
  .ph__label { font-size: var(--fs-h3); font-weight: 600; color: var(--ink); }
  .ph__meta { font-size: var(--fs-small); letter-spacing: 0.01em; }
</style>
