</head>
<body>
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <slot />
  <!-- Enlaces wa.me reales + este módulo: marca de origen, código de referencia y conversión. -->
  <script is:inline src="/js/conversion-tracking.js?v=20260917-ref-review1" defer></script>
