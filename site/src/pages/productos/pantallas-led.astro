---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Dock from '../../components/Dock.astro';
import Icon from '../../components/Icon.astro';
import { wa } from '../../data/site';

import heroImg from '@repo/proyectos_imagenes/proyecto_14.webp';
import ifi960 from '@repo/imagenes_productos/pantallas_led/indoor/IFI960.webp';
import ri640 from '@repo/imagenes_productos/pantallas_led/indoor/RI640.webp';
import ri960 from '@repo/imagenes_productos/pantallas_led/indoor/RI960.webp';
import vp960 from '@repo/imagenes_productos/pantallas_led/outdoor/VP960.webp';
import re640 from '@repo/imagenes_productos/pantallas_led/outdoor/RE640.webp';
import re960 from '@repo/imagenes_productos/pantallas_led/outdoor/RE960.webp';
import p2 from '@repo/proyectos_imagenes/proyecto_2.webp';
import p16 from '@repo/proyectos_imagenes/proyecto_16.webp';
import p3 from '@repo/proyectos_imagenes/proyecto_3.webp';
import p15 from '@repo/proyectos_imagenes/proyecto_15.webp';
import p18 from '@repo/proyectos_imagenes/proyecto_18.webp';
import aa2000 from '@repo/logos_clientes/2560px-Aerop_arg_2000_logo.svg.webp';
import bcra from '@repo/logos_clientes/BCRA_logo.svg.webp';
import shell from '@repo/logos_clientes/Logo-Shell.webp';
import caba from '@repo/logos_clientes/Logotipo_de_la_Ciudad_de_Buenos_Aires.svg.webp';
import tyc from '@repo/logos_clientes/TyCSp.webp';
import speed from '@repo/logos_clientes/logo-speed.webp';
import minciencia from '@repo/logos_clientes/Mincienciaarg.webp';

const context = 'pantallas-led';
const quote = 'Hola, quiero cotizar una pantalla LED.\n\nDónde va: \nMedida aproximada: \nUso previsto: ';
const advice = 'Hola, estoy viendo pantallas LED y quiero asesoramiento para elegir la serie y el pitch.';

const groups = [
  {
    name: 'Interior',
    models: [
      { img: ifi960, serie: 'Serie IFI, interior fija', name: 'IFI960', text: 'Instalación fija con mantenimiento frontal por imanes. Para estudios de TV, aeropuertos y centros de convenciones.', pitch: 'P1.25 a P4', nits: '500 a 600 nits', panel: '960 × 960 mm', href: '/productos.html?cat=pantallas-led&sub=indoor&model=ifi960' },
      { img: ri640, serie: 'Serie RI, interior', name: 'RI640', text: 'Gabinete de aluminio y magnesio fundido a presión. Montaje rápido con quick lock, liviano y versátil.', pitch: 'P1.86 a P4', nits: '500 a 600 nits', panel: '640 × 640 mm', href: '/productos.html?cat=pantallas-led&sub=indoor&model=ri640' },
      { img: ri960, serie: 'Serie RI, interior', name: 'RI960', text: 'Gabinete de aluminio y magnesio con quick lock y puerta trasera de doble batiente.', pitch: 'P2.5 a P4', nits: '500 a 600 nits', panel: '960 × 960 mm', href: '/productos.html?cat=pantallas-led&sub=indoor&model=ri960' },
    ],
  },
  {
    name: 'Exterior y eventos',
    models: [
      { img: vp960, serie: 'Serie VP, exterior fija', name: 'VP960', text: 'Para cartelería digital y publicidad exterior. Protección IP65 frontal.', pitch: 'P2.5 a P8', nits: '4500 a 5500 nits', panel: '960 × 960 mm', href: '/productos.html?cat=pantallas-led&sub=outdoor&model=vp960' },
      { img: re640, serie: 'Serie RE, eventos y escenario', name: 'RE640', text: 'IP65 frontal, para eventos al aire libre y escenarios.', pitch: 'P2.5 a P8', nits: '4500 a 5500 nits', panel: '640 × 640 mm', href: '/productos.html?cat=pantallas-led&sub=outdoor&model=re640' },
      { img: re960, serie: 'Serie RE, eventos y escenario', name: 'RE960', text: 'Alta protección IP, diseñado para shows y eventos exteriores.', pitch: 'P2.5 a P8', nits: '4500 a 5500 nits', panel: '960 × 960 mm', href: '/productos.html?cat=pantallas-led&sub=outdoor&model=re960' },
    ],
  },
];

const logos = [
  { img: aa2000, alt: 'Aeropuertos Argentina 2000' },
  { img: bcra, alt: 'Banco Central de la República Argentina' },
  { img: shell, alt: 'Shell' },
  { img: tyc, alt: 'TyC Sports' },
  { img: caba, alt: 'Ciudad de Buenos Aires' },
  { img: minciencia, alt: 'Ministerio de Ciencia' },
  { img: speed, alt: 'Speed' },
];

const projects = [
  { img: p2, caption: 'Estación de servicio' },
  { img: p16, caption: 'Showroom de vehículos' },
  { img: p3, caption: 'Escenario de evento' },
  { img: p15, caption: 'Salón de eventos' },
  { img: p18, caption: 'Local nocturno' },
];

const steps = [
  { title: 'Relevamiento y definición técnica', text: 'Medidas, distancia de visión y consumo eléctrico antes de cotizar.' },
  { title: 'Fabricación e instalación', text: 'Armado en la medida y el pitch definidos, con estructura y puesta en marcha a cargo nuestro.' },
  { title: 'Repuestos y servicio técnico', text: 'Módulos, fuentes y placas disponibles después de la instalación.' },
];

const statement = 'Primero definimos dónde va, desde qué distancia se mira y cuánta luz recibe. Después elegimos la serie, el pitch y el gabinete.';
---
<Base
  title="Pantallas LED para interior y exterior — Fabricación e instalación | RTM"
  description="Fabricamos, vendemos e instalamos pantallas LED de interior, exterior, escenario y vehiculares. Definimos serie, pitch y medida según el lugar y el uso."
  path="/productos/pantallas-led.html"
  ogImage="/proyectos_imagenes/proyecto_2.webp"
  trackingVersion="20260813-beacon1"
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: 'Productos', path: '/productos.html' },
    { name: 'Pantallas LED', path: '/productos/pantallas-led.html' },
  ]}
>
  <Header context={context} advice={advice} current="/productos.html" />

  <main id="contenido">
    <!-- HERO · oscuro. Tipografía a escala arquitectónica + el producto encendido. -->
    <section class="hero band--black">
      <div class="wrap hero__grid">
        <nav class="hero__crumbs fade-in" aria-label="Migas de pan">
          <a href="/index.html">Inicio</a><span aria-hidden="true">/</span><a href="/productos.html">Productos</a><span aria-hidden="true">/</span><span aria-current="page">Pantallas LED</span>
        </nav>

        <h1 class="hero__title">
          <span class="rise t-hero"><span style="--d: 80ms">Pantallas LED</span></span>{' '}
          <span class="rise t-hero"><span style="--d: 180ms">profesionales</span></span>{' '}
          <span class="rise hero__sub t-display"><span style="--d: 300ms">fabricación, venta e instalación</span></span>
        </h1>

        <div class="hero__copy">
          <p class="t-lead muted fade-in" style="--d: 450ms">Fabricamos a medida según el espacio y la distancia de visión, e instalamos en todo el país.</p>
          <div class="hero__actions fade-in" style="--d: 560ms">
            <a class="btn btn--primary" href={wa(quote)} target="_blank" rel="noopener noreferrer"
               data-conversion="whatsapp_click" data-conversion-placement="landing_hero" data-context={context}>
              <Icon name="whatsapp-logo" />Pedir cotización
            </a>
            <a class="link-arrow" href="/productos.html?cat=pantallas-led"
               data-conversion="content_cta_click" data-conversion-placement="landing_hero_catalogo" data-context={context}>
              Ver modelos y fichas técnicas<Icon name="arrow-right" />
            </a>
          </div>
        </div>

        <div class="hero__media fade-in" style="--d: 250ms">
          <Image src={heroImg} alt="Pantalla LED encendida en un salón oscuro" widths={[480, 800, 1280]} sizes="(min-width: 960px) 56vw, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- CLIENTES · blanco. Logos y nada más. -->
    <section class="logos band band--white" aria-labelledby="logos-title">
      <div class="wrap">
        <h2 id="logos-title" class="logos__title muted reveal">Empresas e instituciones que eligieron RTM</h2>
        <ul class="logos__row reveal">
          {logos.map(l => <li><Image src={l.img} alt={l.alt} height={56} densities={[1, 2]} /></li>)}
        </ul>
      </div>
    </section>

    <!-- CRITERIO · blanco. La frase se ilumina palabra por palabra al leerla: sigue al scroll, no lo frena. -->
    <section class="statement band band--white" aria-label="Cómo definimos cada pantalla">
      <div class="wrap">
        <p class="statement__text t-display">
          {statement.split(' ').map(w => <span class="w">{w} </span>)}
        </p>
      </div>
    </section>

    <!-- MODELOS · gris claro. Ancla #modelos-title: la usan sitelinks de Google Ads. -->
    <section class="models band band--mist" aria-labelledby="modelos-title">
      <div class="wrap">
        <h2 class="t-h2 reveal" id="modelos-title">Seis modelos para interior, exterior y eventos</h2>

        {groups.map(group => (
          <div class="models__group">
            <h3 class="models__group-name t-h3 reveal">{group.name}</h3>
            <ul class="models__grid" tabindex="0" aria-label={`Modelos de ${group.name.toLowerCase()}`}>
              {group.models.map(m => (
                <li class="model reveal">
                  <a class="model__media" href={m.href} tabindex="-1" aria-hidden="true">
                    <Image src={m.img} alt="" widths={[360, 640]} sizes="(min-width: 900px) 30vw, 40vw" />
                  </a>
                  <div class="model__body">
                    <p class="model__serie muted">{m.serie}</p>
                    <h4 class="model__name">{m.name}</h4>
                    <p class="model__text muted">{m.text}</p>
                    <dl class="model__specs">
                      <div><dt>Pitch</dt><dd>{m.pitch}</dd></div>
                      <div><dt>Brillo</dt><dd>{m.nits}</dd></div>
                      <div><dt>Panel</dt><dd>{m.panel}</dd></div>
                    </dl>
                    <a class="link-arrow" href={m.href}>Ver ficha técnica<span class="sr-only"> de {m.name}</span><Icon name="arrow-right" /></a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="models__more reveal">
          <p class="muted">También fabricamos las series Galileo para configuraciones especiales y Shell para vehículos o flotas.</p>
          <a class="btn btn--primary" href={wa(quote)} target="_blank" rel="noopener noreferrer"
             data-conversion="whatsapp_click" data-conversion-placement="landing_modelos" data-context={context}>
            <Icon name="whatsapp-logo" />Pedir cotización
          </a>
        </div>
      </div>
    </section>

    <!-- PROCESO · oscuro. Ancla #proceso-title. La línea roja avanza con la lectura. -->
    <section class="process band band--ink" aria-labelledby="proceso-title">
      <div class="wrap process__grid">
        <div class="process__head">
          <h2 class="t-h2 reveal" id="proceso-title">Qué incluye el trabajo</h2>
          <p class="t-lead muted reveal">Respondemos con serie, medida y valor.</p>
        </div>
        <ol class="process__steps">
          {steps.map(s => (
            <li class="reveal">
              <h3 class="t-h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PROYECTOS · blanco. Bento de 5 fotos reales, 5 celdas. -->
    <section class="projects band band--white" aria-labelledby="proyectos-title">
      <div class="wrap">
        <h2 class="t-h2 reveal" id="proyectos-title">Instaladas y funcionando</h2>
        <ul class="projects__bento">
          {projects.map((p, i) => (
            <li class={`projects__cell projects__cell--${i + 1}`}>
              <figure>
                <div class="projects__frame reveal-media">
                  <Image src={p.img} alt={p.caption} widths={[480, 960]} sizes={i === 0 ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 30vw, 100vw'} />
                </div>
                <figcaption class="muted">{p.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <a class="link-arrow projects__all" href="/proyectos.html">Ver todos los proyectos<Icon name="arrow-right" /></a>
      </div>
    </section>

    <!-- CIERRE · el único bloque rojo de la página. Ancla #cotizar: la usan sitelinks de Google Ads. -->
    <section class="closing" id="cotizar" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="closing__panel band--red">
          <h2 class="t-display" id="cta-title">Contanos dónde va la pantalla</h2>
          <p class="t-lead muted">Indicanos la ubicación, la medida aproximada y el uso previsto. Devolvemos una propuesta con serie, pitch, medida final y valor.</p>
          <div class="closing__actions">
            <a class="btn btn--light" href={wa(quote)} target="_blank" rel="noopener noreferrer"
               data-conversion="whatsapp_click" data-conversion-placement="landing_final" data-context={context}>
              <Icon name="whatsapp-logo" />Pedir cotización
            </a>
            <a class="btn btn--ghost" href="/proyectos.html"
               data-conversion="content_cta_click" data-conversion-placement="landing_final_proyectos" data-context={context}>
              Ver proyectos instalados
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer context={context} advice={advice} />
  <Dock context={context} advice={advice} product="Pantallas LED" />
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- Hero ---------- */
  .hero {
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 72px));
    padding-bottom: clamp(56px, 8vw, 120px);
    overflow: clip;
  }
  .hero__grid { display: grid; gap: 28px; }
  .hero__crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-size: var(--fs-small); color: var(--muted-dark); }
  .hero__crumbs a { text-decoration: none; }
  .hero__crumbs a:hover { color: var(--white); }
  .hero__title { display: grid; }
  .hero__sub { margin-top: 0.3em; color: var(--red); }
  .hero__copy { display: grid; gap: 28px; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .hero__media { margin-inline: calc(var(--gutter) * -1); }
  .hero__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 599px) {
    .hero__actions .btn { width: 100%; }
  }

  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 5fr 7fr; column-gap: 56px; row-gap: 40px; }
    .hero__crumbs, .hero__title { grid-column: 1 / -1; }
    .hero__copy { align-self: start; padding-top: 12px; }
    .hero__media { margin-inline: 0 calc(var(--gutter) * -1); }
  }

  /* El producto se acerca apenas mientras se baja: profundidad sin mover el texto. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__media :global(img) {
        animation: drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }
  @keyframes drift { from { transform: scale(1.06); } to { transform: scale(1) translateY(-4%); } }

  /* ---------- Logos ---------- */
  .logos { padding-block: clamp(56px, 7vw, 96px); }
  .logos__title { font-size: var(--fs-small); font-weight: 500; text-align: center; margin-bottom: 36px; }
  .logos__row {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px 56px;
  }
  .logos__row :global(img) {
    height: 40px; width: auto; max-width: 140px; object-fit: contain;
    filter: grayscale(1); opacity: 0.75; transition: filter 0.4s var(--ease), opacity 0.4s var(--ease);
  }
  .logos__row li:hover :global(img) { filter: none; opacity: 1; }

  /* ---------- Frase ---------- */
  .statement { padding-top: 0; }
  .statement__text { max-width: 22ch; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement .w {
        animation: light-up linear both;
        animation-timeline: view();
        animation-range: cover 18% cover 42%;
      }
    }
  }
  @keyframes light-up { from { color: color-mix(in srgb, var(--ink) 38%, var(--white)); } to { color: var(--ink); } }

  /* ---------- Modelos ---------- */
  .models .t-h2 { max-width: 18ch; }
  .models__group { margin-top: clamp(56px, 7vw, 96px); }
  .models__group-name { padding-top: 18px; border-top: 1px solid var(--line); margin-bottom: 28px; }
  /* Mobile: fila deslizable con la tarjeta siguiente asomando (se entiende que hay más sin leer nada).
     Desktop: grilla de 3. */
  .models__grid {
    list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 8px;
    display: grid; grid-auto-flow: column; grid-auto-columns: 84%; gap: 14px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .models__grid::-webkit-scrollbar { display: none; }
  .model { display: grid; grid-template-rows: auto 1fr; gap: 20px; background: var(--white); padding: 22px; scroll-snap-align: start; }
  .model__media { display: block; background: var(--white); overflow: clip; align-self: start; }
  .model__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; transition: transform 0.7s var(--ease); }
  .model:hover .model__media :global(img) { transform: scale(1.05); }
  .model__body { display: grid; gap: 8px; align-content: start; }
  .model__serie { font-size: var(--fs-small); }
  .model__name { font-size: var(--fs-h3); letter-spacing: -0.01em; line-height: 1.1; }
  .model__text { font-size: var(--fs-small); line-height: 1.5; }
  .model__specs { display: grid; gap: 4px; margin: 8px 0 0; }
  .model__specs div { display: flex; gap: 10px; font-size: var(--fs-small); }
  .model__specs dt { color: var(--muted); min-width: 56px; }
  .model__specs dd { margin: 0; font-weight: 600; }
  .models__more { display: grid; gap: 24px; justify-items: start; margin-top: clamp(48px, 6vw, 72px); max-width: 60ch; }

  @media (min-width: 900px) {
    .models__grid { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 0; padding: 0; overflow: visible; }
    .model { padding: 28px; gap: 24px; }
  }

  /* ---------- Proceso ---------- */
  .process__grid { display: grid; gap: 48px; }
  .process__head { display: grid; gap: 20px; align-content: start; }
  .process__steps { list-style: none; margin: 0; padding: 0 0 0 28px; display: grid; gap: 48px; position: relative; }
  /* ::before es la guía gris; ::after, pintado encima, es el avance en rojo. */
  .process__steps::before, .process__steps::after {
    content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px;
  }
  .process__steps::before { background: var(--line); }
  .process__steps::after { background: var(--red); transform-origin: top; }
  .process__steps li { display: grid; gap: 10px; }
  .process__steps p { max-width: 46ch; }

  @media (min-width: 900px) {
    .process__grid { grid-template-columns: 5fr 7fr; gap: 80px; }
    .process__head { position: sticky; top: calc(var(--header-h) + 48px); align-self: start; }
    .process__steps { padding-left: 48px; gap: 72px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .process__steps::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: cover 15% cover 65%;
      }
    }
  }
  @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  /* ---------- Proyectos ---------- */
  .projects__bento { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; gap: 28px; }
  .projects__cell figure { margin: 0; display: grid; gap: 12px; }
  .projects__frame { overflow: clip; }
  .projects__frame :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.9s var(--ease); }
  .projects__cell:hover .projects__frame :global(img) { transform: scale(1.04); }
  .projects__cell figcaption { font-size: var(--fs-small); }
  .projects__all { margin-top: 36px; }

  @media (min-width: 900px) {
    .projects__bento { grid-template-columns: repeat(12, 1fr); gap: 24px; }
    .projects__cell--1 { grid-column: 1 / 8; grid-row: span 2; }
    .projects__cell--1 :global(img) { aspect-ratio: auto; height: 100%; min-height: 560px; }
    .projects__cell--1 figure { height: 100%; grid-template-rows: 1fr auto; }
    .projects__cell--1 .projects__frame { height: 100%; }
    .projects__cell--2 { grid-column: 8 / 13; }
    .projects__cell--3 { grid-column: 8 / 13; }
    .projects__cell--4 { grid-column: 1 / 6; }
    .projects__cell--5 { grid-column: 6 / 13; }
    .projects__cell--2 :global(img), .projects__cell--3 :global(img) { aspect-ratio: 16 / 10; }
    .projects__cell--4 :global(img), .projects__cell--5 :global(img) { aspect-ratio: auto; height: 420px; }
  }

  /* ---------- Cierre ---------- */
  .closing { background: var(--white); padding-bottom: var(--section); }
  .closing__panel { padding: clamp(40px, 7vw, 104px) clamp(24px, 6vw, 96px); display: grid; gap: 28px; }
  .closing__panel .t-display { max-width: 16ch; }
  .closing__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  @media (max-width: 599px) { .closing__actions .btn { width: 100%; } }

  /* El bloque se asienta al entrar: marca el final del recorrido. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .closing__panel {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes settle { from { transform: scale(0.94); } to { transform: none; } }
</style>
