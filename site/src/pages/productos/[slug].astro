---
/**
 * Plantilla de las landings de producto (/productos/<slug>.html).
 * El contenido de cada una vive en src/data/landings/<slug>.ts. Los modelos salen de data/products.json.
 * CONTRATO (lo leen Google Ads y el tracking; ver site/README.md): anclas #modelos-title #proceso-title
 * #cotizar y los placements landing_header/hero/modelos/final/footer/persistent + landing_hero_catalogo
 * y landing_final_proyectos. No renombrar.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import Dock from '../../components/Dock.astro';
import Icon from '../../components/Icon.astro';
import { wa } from '../../data/site';
import { image, modelGroups, type Landing } from '../../lib/landing';

import aa2000 from '@repo/logos_clientes/2560px-Aerop_arg_2000_logo.svg.webp';
import bcra from '@repo/logos_clientes/BCRA_logo.svg.webp';
import shell from '@repo/logos_clientes/Logo-Shell.webp';
import caba from '@repo/logos_clientes/Logotipo_de_la_Ciudad_de_Buenos_Aires.svg.webp';
import tyc from '@repo/logos_clientes/TyCSp.webp';
import speed from '@repo/logos_clientes/logo-speed.webp';
import minciencia from '@repo/logos_clientes/Mincienciaarg.webp';

export function getStaticPaths() {
  const files = import.meta.glob<{ default: Landing }>('../../data/landings/*.ts', { eager: true });
  return Object.values(files).map(f => ({ params: { slug: f.default.slug }, props: { landing: f.default } }));
}

const { landing: l } = Astro.props as { landing: Landing };
const context = l.slug;
const path = `/productos/${l.slug}.html`;
const groups = modelGroups(l);
const catalog = `/productos.html?cat=${l.category}`;
const ModelHeading = groups.length > 1 ? 'h4' : 'h3';

const logos = [
  { img: aa2000, alt: 'Aeropuertos Argentina 2000' },
  { img: bcra, alt: 'Banco Central de la República Argentina' },
  { img: shell, alt: 'Shell' },
  { img: tyc, alt: 'TyC Sports' },
  { img: caba, alt: 'Ciudad de Buenos Aires' },
  { img: minciencia, alt: 'Ministerio de Ciencia' },
  { img: speed, alt: 'Speed' },
];
---
<Base
  title={l.seo.title}
  description={l.seo.description}
  path={path}
  ogImage={l.seo.ogImage}
  trackingVersion={l.trackingVersion}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: 'Productos', path: '/productos.html' },
    { name: l.product, path },
  ]}
>
  <Header context={context} advice={l.wa.advice} current="/productos.html" />

  <main id="contenido">
    <Hero
      crumbs={[{ name: 'Inicio', href: '/index.html' }, { name: 'Productos', href: '/productos.html' }, { name: l.product }]}
      title={l.hero.h1}
      sub={l.hero.accent}
      lead={l.hero.lead}
      context={context}
      quoteHref={wa(l.wa.quote)}
      catalogHref={groups.length ? catalog : undefined}
      image={image(l.hero.image)}
      focus={l.hero.focus}
    />

    <!-- CLIENTES · blanco. Logos y nada más. -->
    <section class="logos band band--white" aria-labelledby="logos-title">
      <div class="wrap">
        <h2 id="logos-title" class="logos__title muted reveal">Empresas e instituciones que eligieron RTM</h2>
        <ul class="logos__row reveal">
          {logos.map(logo => <li><Image src={logo.img} alt={logo.alt} height={56} densities={[1, 2]} /></li>)}
        </ul>
      </div>
    </section>

    <!-- MODELOS · gris claro. Ancla #modelos-title (sitelinks de Google Ads). -->
    <section class="models band band--mist" aria-labelledby="modelos-title">
      <div class="wrap">
        <h2 class="t-h2 reveal" id="modelos-title">{l.models.title}</h2>

        {groups.map(group => (
          <div class="models__group">
            {groups.length > 1 && <h3 class="models__group-name t-h3 reveal">{group.name}</h3>}
            <ul class="models__grid" tabindex="0" aria-label={`Modelos: ${group.name}`} style={`--cols: ${Math.min(3, group.models.length)}`}>
              {group.models.map(m => (
                <li class="model reveal">
                  <div class="model__media">
                    <Image src={m.image} alt="" widths={[360, 640]} sizes="(min-width: 900px) 30vw, 80vw" />
                  </div>
                  <div class="model__body">
                    <ModelHeading class="model__name">{m.name}</ModelHeading>
                    {m.specs.length > 0 && (
                      <dl class="model__specs">
                        {m.specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
                      </dl>
                    )}
                    <a class="link-arrow model__link" href={m.href}>Ver ficha<span class="sr-only"> de {m.name}</span><Icon name="arrow-right" /></a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}

        {groups.length === 0 && l.models.gallery && (
          <ul class="gallery">
            {l.models.gallery.map(g => (
              <li class="reveal">
                <figure>
                  <div class="gallery__frame"><Image src={image(g.image)} alt={g.caption} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" /></div>
                  <figcaption class="muted">{g.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}

        <div class="models__more reveal">
          {l.models.note && <p class="muted">{l.models.note}</p>}
          <a class="btn btn--primary" href={wa(l.wa.quote)} target="_blank" rel="noopener noreferrer"
             data-conversion="whatsapp_click" data-conversion-placement="landing_modelos" data-context={context}>
            <Icon name="whatsapp-logo" />Pedir cotización
          </a>
        </div>
      </div>
    </section>

    <!-- PROCESO · azul noche. Ancla #proceso-title (sitelinks de Google Ads). -->
    <section class="process band band--ink" aria-labelledby="proceso-title">
      <div class="wrap process__grid">
        <div class="process__head">
          <h2 class="t-h2 reveal" id="proceso-title">Qué incluye el trabajo</h2>
          {l.process.lead && <p class="t-lead muted reveal">{l.process.lead}</p>}
        </div>
        <ol class="process__steps">
          {l.process.steps.map(s => (
            <li class="reveal">
              <h3 class="t-h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PROYECTOS · blanco. Fotos reales, 3 a 5 celdas. -->
    <section class="projects band band--white" aria-labelledby="proyectos-title">
      <div class="wrap">
        <h2 class="t-h2 reveal" id="proyectos-title">{l.projects.title}</h2>
        <ul class="projects__bento" data-count={l.projects.items.length}>
          {l.projects.items.map((p, i) => (
            <li class={`projects__cell projects__cell--${i + 1}`}>
              <figure>
                <div class="projects__frame reveal-media">
                  <Image src={image(p.image)} alt={p.caption} widths={[480, 960]} sizes={i === 0 ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 40vw, 100vw'} />
                </div>
                <figcaption class="muted">{p.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <a class="link-arrow projects__all" href="/proyectos.html">Ver todos los proyectos<Icon name="arrow-right" /></a>
      </div>
    </section>

    <!-- CIERRE · el único bloque rojo. Ancla #cotizar (sitelinks de Google Ads). -->
    <section class="closing" id="cotizar" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="closing__panel band--red">
          <h2 class="t-display" id="cta-title">{l.closing.title}</h2>
          <p class="t-lead">{l.closing.lead}</p>
          <div class="closing__actions">
            <a class="btn btn--light" href={wa(l.wa.quote)} target="_blank" rel="noopener noreferrer"
               data-conversion="whatsapp_click" data-conversion-placement="landing_final" data-context={context}>
              <Icon name="whatsapp-logo" />Pedir cotización
            </a>
            <a class="btn btn--ghost" href="/proyectos.html"
               data-conversion="content_cta_click" data-conversion-placement="landing_final_proyectos" data-context={context}>
              Ver proyectos
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer context={context} advice={l.wa.advice} />
  <Dock context={context} advice={l.wa.advice} product={l.product} />
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- Logos ---------- */
  .logos { padding-block: clamp(40px, 5vw, 64px); }
  .logos__title { font-size: var(--fs-small); font-weight: 500; text-align: center; margin-bottom: 24px; }
  .logos__row {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px 56px;
  }
  .logos__row :global(img) {
    height: 40px; width: auto; max-width: 140px; object-fit: contain;
    filter: grayscale(1); opacity: 0.75; transition: filter 0.4s var(--ease), opacity 0.4s var(--ease);
  }
  .logos__row li:hover :global(img) { filter: none; opacity: 1; }

  /* ---------- Modelos ---------- */
  .models .t-h2 { max-width: 18ch; }
  .models__group { margin-top: clamp(28px, 3vw, 40px); }
  .models__group-name { padding-top: 18px; border-top: 1px solid var(--line); margin-bottom: 28px; }
  /* Mobile: fila deslizable con la tarjeta siguiente asomando. Desktop: grilla de 3. */
  .models__grid {
    list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 8px;
    display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 14px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .models__grid::-webkit-scrollbar { display: none; }
  .model {
    position: relative; display: grid; grid-template-rows: auto 1fr; gap: 20px;
    background: var(--white); padding: 22px; border-radius: var(--radius); scroll-snap-align: start;
    outline: 1.5px solid transparent; transition: outline-color 0.3s var(--ease);
  }
  .model:hover, .model:focus-within { outline-color: var(--line); }
  /* Toda la tarjeta lleva a la ficha: blanco grande para tocar, un solo link para lectores de pantalla. */
  .model__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .model__link:focus-visible { outline: none; }
  .model__link:focus-visible::after { outline: 3px solid var(--red); outline-offset: 3px; }
  .model__media { display: block; background: var(--white); border-radius: var(--radius-sm); overflow: clip; align-self: start; }
  .model__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; transition: transform 0.7s var(--ease); }
  .model:hover .model__media :global(img) { transform: scale(1.05); }
  .model__body { display: grid; gap: 10px; align-content: start; }
  .model__name { font-size: var(--fs-h3); letter-spacing: -0.01em; line-height: 1.1; }
  .model__specs { display: grid; gap: 4px; margin: 0; }
  .model__specs div { display: flex; gap: 10px; font-size: var(--fs-small); }
  .model__specs dt { color: var(--muted); min-width: 64px; }
  .model__specs dd { margin: 0; font-weight: 600; }
  .models__more { display: grid; gap: 20px; justify-items: start; margin-top: clamp(32px, 4vw, 48px); max-width: 60ch; }

  .gallery { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; gap: 24px; }
  .gallery figure { margin: 0; display: grid; gap: 12px; }
  .gallery__frame { border-radius: var(--radius); overflow: clip; background: var(--white); }
  .gallery__frame :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery figcaption { font-size: var(--fs-small); }

  @media (min-width: 900px) {
    /* Tantas columnas como modelos (máx. 3): con 2 modelos no queda una columna vacía. */
    .models__grid { grid-auto-flow: row; grid-template-columns: repeat(var(--cols, 3), minmax(0, 360px)); gap: 24px; margin: 0; padding: 0; overflow: visible; }
    .model { padding: 28px; gap: 24px; }
    .gallery { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---------- Proceso ---------- */
  .process__grid { display: grid; gap: 48px; }
  .process__head { display: grid; gap: 20px; align-content: start; }
  .process__steps { list-style: none; margin: 0; padding: 0 0 0 28px; display: grid; gap: 48px; position: relative; }
  /* ::before es la guía gris; ::after, pintado encima, es el avance en rojo. */
  .process__steps::before, .process__steps::after {
    content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px;
  }
  .process__steps::before { background: var(--line); }
  .process__steps::after { background: var(--red); transform-origin: top; }
  .process__steps li { display: grid; gap: 10px; }
  .process__steps p { max-width: 40ch; }

  @media (min-width: 900px) {
    .process__grid { grid-template-columns: 5fr 7fr; gap: 80px; }
    .process__head { position: sticky; top: calc(var(--header-h) + 48px); align-self: start; }
    .process__steps { padding-left: 48px; gap: 44px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .process__steps::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: cover 15% cover 65%;
      }
    }
  }
  @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  /* ---------- Proyectos (3 a 5 fotos) ---------- */
  .projects__bento { list-style: none; margin: clamp(28px, 3vw, 40px) 0 0; padding: 0; display: grid; gap: 24px; }
  .projects__cell figure { margin: 0; display: grid; gap: 12px; }
  /* Fondo gris claro: los renders de producto con fondo blanco no se funden con la banda. */
  .projects__frame { overflow: clip; border-radius: var(--radius); background: var(--mist); }
  .projects__frame :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.9s var(--ease); }
  .projects__cell:hover .projects__frame :global(img) { transform: scale(1.04); }
  .projects__cell figcaption { font-size: var(--fs-small); }
  .projects__all { margin-top: 24px; }

  @media (min-width: 900px) {
    .projects__bento { grid-template-columns: repeat(12, 1fr); gap: 24px; }
    /* 3 y 5: una foto grande a la izquierda, dos apiladas a la derecha. */
    .projects__bento:is([data-count="3"], [data-count="5"]) .projects__cell--1 { grid-column: 1 / 8; grid-row: span 2; }
    .projects__bento:is([data-count="3"], [data-count="5"]) .projects__cell--1 figure { height: 100%; grid-template-rows: 1fr auto; }
    .projects__bento:is([data-count="3"], [data-count="5"]) .projects__cell--1 .projects__frame { height: 100%; }
    .projects__bento:is([data-count="3"], [data-count="5"]) .projects__cell--1 :global(img) { aspect-ratio: auto; height: 100%; min-height: 560px; }
    .projects__bento:is([data-count="3"], [data-count="5"]) :is(.projects__cell--2, .projects__cell--3) { grid-column: 8 / 13; }
    .projects__bento:is([data-count="3"], [data-count="5"]) :is(.projects__cell--2, .projects__cell--3) :global(img) { aspect-ratio: 16 / 10; }
    /* 5: fila de abajo con dos fotos de igual alto. */
    .projects__bento[data-count="5"] .projects__cell--4 { grid-column: 1 / 6; }
    .projects__bento[data-count="5"] .projects__cell--5 { grid-column: 6 / 13; }
    .projects__bento[data-count="5"] :is(.projects__cell--4, .projects__cell--5) :global(img) { aspect-ratio: auto; height: 420px; }
    /* 4: dos por dos. */
    .projects__bento[data-count="4"] .projects__cell { grid-column: span 6; }
  }

  /* ---------- Cierre ---------- */
  .closing { background: var(--white); padding-bottom: var(--section); }
  .closing__panel { padding: clamp(36px, 5vw, 72px) clamp(24px, 5vw, 72px); display: grid; gap: 28px; border-radius: var(--radius-lg); }
  .closing__panel .t-display { max-width: 16ch; }
  .closing__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  @media (max-width: 599px) { .closing__actions .btn { width: 100%; } }

  /* El bloque se asienta al entrar: marca el final del recorrido. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .closing__panel {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes settle { from { transform: scale(0.94); } to { transform: none; } }
</style>
