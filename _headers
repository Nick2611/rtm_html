# Headers para AWS Amplify
# https://pantallasledrtm.com

# Favicon - CRÍTICO para SEO
/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon-precomposed.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

# Logo para Schema.org
/rtm_logo/rtmLogo.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

# Archivos SEO
/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400

# HTML - No cachear agresivamente
/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

# CSS y JavaScript
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes
/rtm_logo/*
  Cache-Control: public, max-age=31536000, immutable

/imagenes_productos/*
  Cache-Control: public, max-age=31536000, immutable

/imagenes_productos_restantes/*
  Cache-Control: public, max-age=31536000, immutable

/imagenes_productos/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

/imagenes_productos_restantes/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

/proyectos_imagenes/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

/logos_clientes/*
  Cache-Control: public, max-age=31536000, immutable

/logos_clientes/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

/miniaturas_videos/*
  Cache-Control: public, max-age=31536000, immutable

/proyectos_imagenes/*
  Cache-Control: public, max-age=31536000, immutable

/background_hero/*
  Cache-Control: public, max-age=31536000, immutable

/background_hero/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

/seccion_servicios/*
  Cache-Control: public, max-age=31536000, immutable

/about_background/*
  Cache-Control: public, max-age=31536000, immutable

# Videos
/proyectos_videos/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

# Headers de seguridad globales
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
